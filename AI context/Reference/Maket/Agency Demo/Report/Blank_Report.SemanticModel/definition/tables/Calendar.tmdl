	hierarchy 'Year-Month Slicer'
		lineageTag: 36f214b9-b139-47fc-a6c4-ee3c66b394ca

		level ​
			lineageTag: aa74c750-1787-4136-a860-12056c0d0278
			column: Year

		level ​​
			lineageTag: 37bc6a0d-5246-4f80-b76a-1ddaec448b9b
			column: 'Month Slicer'

	partition Calendar = calculated
		mode: import
		source = ```
				
				VAR __TodayDate = TODAY()
				VAR __Dates =
				    CALENDAR (
				        DATE ( YEAR ( __TodayDate ) - 3, 01, 01 ),
				        DATE ( YEAR ( __TodayDate ) + 3, 12, 31 )
				    )
				VAR __TodayMonday = __TodayDate - WEEKDAY ( __TodayDate, 2 ) + 1
				
				VAR __Result = 
				    ADDCOLUMNS (
				        __Dates                                                                 -- dd/mmm/yyyy ddd
				            , "Year",             YEAR ( [Date] )   
				            , "Year Date",        EOMONTH ( [Date], - MONTH ( [Date] ) ) + 1    -- yyyy           
				            , "Year ID",          DATEDIFF ( __TodayDate, [Date], YEAR  )       -- 0 = Current Year, Negative => history, Positive => Future
				
				            , "Half Of Year",     DATE ( YEAR ( [Date] ), ROUNDDOWN ( ( MONTH ( [Date] ) - 1 ) / 6, 0 ) + 1, 1 )                -- \Hm - yyyy
				
				            , "Quarter Year",     DATE ( YEAR ( [Date] ), ( QUARTER ( [Date] ) - 1 ) * 3 + 1, QUARTER ( [Date] ) )              -- yyyy \Qd
				            , "Quarter Name",     DATE ( YEAR ( [Date] ), ( QUARTER ( [Date] ) - 1 ) * 3 + 1, QUARTER ( [Date] ) )              -- \Qd
				            , "Quarter ID",       DATEDIFF ( __TodayDate, [Date], QUARTER  )                                                    -- 0 = Current Quarter, Negative => history, Positive => Future
				            , "Current Quarter",  QUARTER ( [Date] ) = QUARTER ( __TodayDate ) && YEAR ( [Date] ) = YEAR ( __TodayDate )        -- OR  "Quarter ID" = 0
				
				            , "Month Year",       EOMONTH ( [Date], -1 ) +1                             -- mmm yyyy
				            , "Month Name",       EOMONTH ( [Date], -1 ) +1                             -- mmm
				            , "Month Slicer",     EOMONTH ( [Date], -1 ) +1                             -- mmmm, sorted by Month SortBack
				            , "Month ID",         DATEDIFF ( __TodayDate, [Date], MONTH )               -- 0 = Current Month, Negative => history, Positive => Future
				            , "Month SortBack",   DATEDIFF ( __TodayDate, [Date], MONTH ) * ( -1 )      -- to have Recent Month upper in the slicers. Drawback: it's sorting column
				            , "Current Month",    EOMONTH ( [Date], 0 ) = EOMONTH ( __TodayDate, 0 )    -- OR  "Month ID" = 0
				
				            , "IsWorking",        NOT WEEKDAY ( [Date], 2 ) IN { 5, 6 }                 -- Weekends: Friday, Saturday
				            , "Working Day Of Year",
				                    VAR __CurrentYear = YEAR ( [Date] ) 
				                RETURN 
				                    RANKX ( 
				                        FILTER ( 
				                            __Dates
				                            , YEAR ( [Date] ) = __CurrentYear 
				                            && NOT WEEKDAY ( [Date], 2 ) IN { 5, 6 } 
				                        )
				                        , [Date], [Date], ASC, DENSE
				                    )
				
				            , "Closed Period",    [Date] <= __TodayDate
				            , "Today",            [Date] =  __TodayDate
				
				            , "ISO Year",         YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 )    -- ISO 8601: week belongs to the year of its Thursday
				            
				            , "ISO Week",         WEEKNUM ( [Date], 21 )
				            , "ISO Week Date",    [Date] + TIME ( 0, 0, WEEKNUM ( [Date], 21 ) ) -- \Ws dd mmm yy
				            , "ISO Week ID",      DATEDIFF ( __TodayMonday, [Date] - WEEKDAY ( [Date], 2 ) + 1, DAY ) / 7    -- 0 = Current Week, Negative => history, Positive => Future
				
				            , "ISO Week as Date",
				                    VAR __Weekday   = WEEKDAY ( [Date], 2 )
				                    VAR __WeekStart = [Date] - __Weekday + 1
				                    VAR __WeekEnd   = [Date] - __Weekday + 7
				                RETURN
				                    __WeekStart + TIME ( MONTH ( __WeekEnd ), WEEKNUM ( [Date], 21 ), DAY ( __WeekEnd ) )
				                    -- format "\Wnn: dd.mm - ss.hh" → "W09: 29.02 - 06.03"
				                    -- week number in minutes, end-of-week day/month in seconds/hours; date part is real, so the column sorts chronologically
				
				        )
				RETURN
				    __Result
				```

