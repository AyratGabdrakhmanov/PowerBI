/// Running total from the first date of the Calendar to the last date in context (CG item CUM)
/// @param {EXPR} baseMeasure - the measure to accumulate, e.g. [Sales Amount]
function 'TI.CUM' =
		( baseMeasure : EXPR ) =>
		CALCULATE (
		    baseMeasure
		    , 'Calendar'[Date] <= MAX ( 'Calendar'[Date] )
		)
	lineageTag: c7e3e09e-9b52-4270-a9e8-d7c07735d5db

/// Year-to-date (CG item YTD)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.YTD' =
		( baseMeasure : EXPR ) =>
		CALCULATE (
		    baseMeasure
		    , DATESYTD ( 'Calendar'[Date] )
		)
	lineageTag: 7cd46d95-c8f2-4e03-bb69-8b915678f678

