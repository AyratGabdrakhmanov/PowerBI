/// Previous year quarter complete = the whole same quarter previous year (same pattern as TI.PYMC)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.PYQC' =
		( baseMeasure : EXPR ) =>
		CALCULATE (
		    baseMeasure
		    , DATEADD ( PARALLELPERIOD ( DATESQTD ( 'Calendar'[Date] ), 0, QUARTER ), -1, YEAR )    -- whole last quarter in context; DATESQTD for the Total on Year level
		)
	lineageTag: 638a2806-aba9-417a-b827-4c7f115d1154

