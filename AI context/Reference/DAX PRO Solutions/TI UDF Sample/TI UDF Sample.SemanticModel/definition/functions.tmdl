/// Last date in context (CG item DTD)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.DTD' =
		( baseMeasure : EXPR ) =>
		CALCULATE (
		    baseMeasure
		    , 'Calendar'[Date] = MAX ( 'Calendar'[Date] )    -- 2026-10-31 changed: MAX instead of LASTDATE (SQLBI: LASTDATE returns a table and does a hidden context transition when the UDF is called inside an iterator)
		)
	lineageTag: 1b163997-3485-4c0e-9367-6da59bd60e6c

/// Previous day = the day before the last date in context (CG item PD)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.PD' =
		( baseMeasure : EXPR ) =>
		CALCULATE (
		    baseMeasure
		    , 'Calendar'[Date] = MAX ( 'Calendar'[Date] ) - 1
		)
	lineageTag: 93bee381-2c17-4d97-bbaa-edde94d22fdc

/// Same period previous year (CG item PY)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]; nest to shift any period: TI.PY ( TI.YTD ( [X] ) ) = PYTD
function 'TI.PY' =
		( baseMeasure : EXPR ) =>
		CALCULATE (
		    baseMeasure
		    , DATEADD ( 'Calendar'[Date], -1, YEAR )
		)
	lineageTag: c948fdd1-41e0-49b2-821b-2ddfcab22b7b

