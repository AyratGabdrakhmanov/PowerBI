/// December of the previous year (CG item DLY)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.DLY' =
		( baseMeasure : EXPR ) =>
		VAR __DecemberStart = DATE ( YEAR ( MAX ( 'Calendar'[Date] ) ) - 1, 12, 1 )
		RETURN
		    CALCULATE (
		        baseMeasure
		        , DATESBETWEEN ( 'Calendar'[Date], __DecemberStart, EOMONTH ( __DecemberStart, 0 ) )
		    )
	lineageTag: 46f88fc2-4846-4a8e-ac86-b5190cc0792c

/// Rolling N months ending on the last date in context (CG item R12; Prev R12 = TI.PY ( TI.RollingMonths ( [X], 12 ) ))
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
/// @param {INT64} months - window length in months, e.g. 12
function 'TI.RollingMonths' =
		( baseMeasure : EXPR, months : INT64 VAL ) =>
		CALCULATE (
		    baseMeasure
		    , DATESINPERIOD ( 'Calendar'[Date], MAX ( 'Calendar'[Date] ), - months, MONTH )
		)
	lineageTag: 2ed594e6-1355-456b-a05f-5e6ec162e48a

/// Average of the monthly values over the last N months, months with a value > 0 only (CG items Moving 12M Avg, Moving 3M Avg)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
/// @param {INT64} months - window length in months, e.g. 3 or 12
function 'TI.MovingAvg' =
		( baseMeasure : EXPR, months : INT64 VAL ) =>
		CALCULATE (
		    AVERAGEX (
		        FILTER ( VALUES ( 'Calendar'[Month ID] ), baseMeasure > 0 )
		        , baseMeasure
		    )
		    , DATESINPERIOD ( 'Calendar'[Date], MAX ( 'Calendar'[Date] ), - months, MONTH )
		)
	lineageTag: e106518e-ec19-404c-975d-e1cbdcf4a390

/// Shows the measure only for the last N months of the selected period, e.g. a 12-month chart window (CG item 1Y)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
/// @param {INT64} months - number of months to show, the last selected month included
function 'TI.LastNMonths' =
		( baseMeasure : EXPR, months : INT64 VAL ) =>
		VAR __LastSelectedDate = CALCULATE ( MAX ( 'Calendar'[Date] ), ALLSELECTED ( 'Calendar' ) )
		VAR __WindowStart      = EOMONTH ( __LastSelectedDate, - months )    -- last day before the window
		RETURN
		    IF ( MIN ( 'Calendar'[Date] ) > __WindowStart, baseMeasure )
	lineageTag: 8c0988bc-86f5-40d5-a0d1-a83b2caedc47

/// Change = current - previous; blank when the previous value is blank or 0 (CG items YOY, YOYTD, YOQTD, YOMTD, QOQ, MOM, MOMTD, DOD, MODLY, MoM, MTD YoY, YTD YoY, Prev Month Chg)
/// @param {SCALAR} currentValue - e.g. TI.YTD ( [Sales Amount] )
/// @param {SCALAR} previousValue - e.g. TI.PYTD ( [Sales Amount] )
function 'TI.Change' =
		( currentValue : SCALAR VAL, previousValue : SCALAR VAL ) =>
		( currentValue - previousValue ) * DIVIDE ( previousValue, previousValue )
	lineageTag: f2f596fe-1af0-4fbf-a938-e9ae38dc57c3

/// Change % = ( current - previous ) / | previous | (all "... %" comparison CG items)
/// @param {SCALAR} currentValue - e.g. TI.YTD ( [Sales Amount] )
/// @param {SCALAR} previousValue - e.g. TI.PYTD ( [Sales Amount] )
function 'TI.ChangePct' =
		( currentValue : SCALAR VAL, previousValue : SCALAR VAL ) =>
		DIVIDE ( currentValue - previousValue, ABS ( previousValue ) )
	lineageTag: 34341528-af49-4a30-9909-4b81dd3f5a57

/// Change = current - previous; blank when the current OR the previous value is blank or 0 (CG YOY / YOYTD / YOQTD / YOMTD pattern) - for comparisons with last year
/// @param {SCALAR} currentValue - e.g. TI.YTD ( [Sales Amount] )
/// @param {SCALAR} previousValue - e.g. TI.PYTD ( [Sales Amount] )
function 'TI.ChangeIfBoth' =
		( currentValue : SCALAR VAL, previousValue : SCALAR VAL ) =>
		( currentValue - previousValue ) * DIVIDE ( previousValue, previousValue ) * DIVIDE ( currentValue, currentValue )
	lineageTag: 3812e9de-fea7-4032-89ab-a1bc5f8ffce0

/// Change % = ( current - previous ) / | previous |; blank when the current OR the previous value is blank or 0 - for comparisons with last year
/// @param {SCALAR} currentValue - e.g. TI.YTD ( [Sales Amount] )
/// @param {SCALAR} previousValue - e.g. TI.PYTD ( [Sales Amount] )
function 'TI.ChangePctIfBoth' =
		( currentValue : SCALAR VAL, previousValue : SCALAR VAL ) =>
		DIVIDE ( currentValue - previousValue, ABS ( previousValue ) ) * DIVIDE ( currentValue, currentValue )
	lineageTag: 027c5db9-a1b4-4dea-bee7-09b54fd0f24c

/// Previous quarter-to-date, as CG item PQ; the result equals TI.PQTD
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.PQ' =
		( baseMeasure : EXPR ) =>
		CALCULATE (
		    baseMeasure
		    , DATEADD ( DATESQTD ( 'Calendar'[Date] ), -1, QUARTER )    -- 2026-10-31 changed: DATESQTD as in CG PQ, a Year total = its last quarter's previous quarter; before, DATEADD ( 'Calendar'[Date] ) shifted the same dates (May -> Feb, a year by one quarter)
		)
	lineageTag: 1953103e-b898-466c-a849-f98adca475ed

/// Same period one month back (XU PM); with DATESMTD the result equals TI.PMTD
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.PM' =
		( baseMeasure : EXPR ) =>
		CALCULATE (
		    baseMeasure
		    , DATEADD ( DATESMTD ( 'Calendar'[Date] ), -1, MONTH )    -- 2026-10-31 changed: DATESMTD as in CG PMC, a Year / Quarter total = its last month's previous month; before, DATEADD ( 'Calendar'[Date] ) shifted the whole year by one month
		)
	lineageTag: a4da11ed-8873-4fa5-9dd2-cd01cb090a70

/// Previous quarter complete = the whole previous quarter (XU PQC)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.PQC' =
		( baseMeasure : EXPR ) =>
		CALCULATE (
		    baseMeasure
		    , PARALLELPERIOD ( DATESQTD ( 'Calendar'[Date] ), -1, QUARTER )    -- DATESQTD for the Total on Year level
		)
	lineageTag: 8c83c04f-ef9d-4cb9-a9e3-7f4a455db29b

/// Blank for periods that start after the last closed date (SQLBI "Hiding future dates"); wrap running totals: TI.HideFuture ( TI.YTD ( [X] ) )
/// @param {EXPR} baseMeasure - the measure, e.g. TI.YTD ( [Sales Amount] )
function 'TI.HideFuture' =
		( baseMeasure : EXPR ) =>
		VAR __LastClosedDate =
		    CALCULATE (
		        MAX ( 'Calendar'[Date] )
		        , REMOVEFILTERS ( 'Calendar' )
		        , 'Calendar'[Closed Period] = TRUE ()
		    )
		RETURN
		    IF ( MIN ( 'Calendar'[Date] ) <= __LastClosedDate, baseMeasure )
	lineageTag: 045bb1be-9869-45bb-81cd-25aec3bb75fa

/// Whole year N years back, Calendar filters below Year ignored (StoryBi.PriorYearMeas; TI.PYCN ( [X], 1 ) = TI.PYC)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
/// @param {INT64} years - how many years back, e.g. 2
function 'TI.PYCN' =
		( baseMeasure : EXPR, years : INT64 VAL ) =>
		CALCULATE (
		    baseMeasure
		    , PARALLELPERIOD ( 'Calendar'[Date], - years, YEAR )
		)
	lineageTag: c2ef9062-10c2-490e-b6e8-d8aa9e8ff15c

/// Monthly values from a measure stored as YTD (e.g. GL balances): month minus previous month, January as is (EG.YTDDeAccumulate); month level and above; needs the Calendar marked as date table
/// @param {EXPR} ytdMeasure - the YTD-stored measure, e.g. [Balance YTD]
function 'TI.YTDToMonth' =
		( ytdMeasure : EXPR ) =>
		SUMX (
		    KEEPFILTERS ( VALUES ( 'Calendar'[Month Year] ) )
		    , VAR __Month = 'Calendar'[Month Year]
		      RETURN
		          CALCULATE ( ytdMeasure )
		              - IF ( MONTH ( __Month ) <> 1, CALCULATE ( ytdMeasure, DATEADD ( 'Calendar'[Date], -1, MONTH ) ) )
		)
	lineageTag: 7748784e-1a30-4372-bb5e-50238290430a


/// Moving annual total = rolling 12 months (XU MAT; CG item R12)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.MAT' =
		( baseMeasure : EXPR ) =>
		TI.RollingMonths ( baseMeasure, 12 )
	lineageTag: da127f6b-ada1-4840-aa47-7695b9271699

/// Previous year moving annual total (XU PYMAT; CG item Prev R12)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.PYMAT' =
		( baseMeasure : EXPR ) =>
		TI.PY ( TI.RollingMonths ( baseMeasure, 12 ) )
	lineageTag: 63eb9eb3-d606-4775-8710-c31459d7f53a

/// Change, same period vs previous year (XU YOY Δ)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.YOY' =
		( baseMeasure : EXPR ) =>
		TI.ChangeIfBoth ( baseMeasure, TI.PY ( baseMeasure ) )    -- 2026-10-31 changed: blank also when the current value is blank (CG YOY pattern); before, a period without data showed minus last year
