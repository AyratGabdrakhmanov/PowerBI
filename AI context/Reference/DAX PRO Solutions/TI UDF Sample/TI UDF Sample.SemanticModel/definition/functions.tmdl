/// Change, YTD vs the whole previous year (XU YTDOPYC Δ)
/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
/// 2026-10-31 renamed from TI.YTDOPYC (XU name). Always compares with the whole previous period
function 'TI.YTDvsFullPY' =
		( baseMeasure : EXPR ) =>
		TI.ChangeIfBoth ( TI.YTD ( baseMeasure ), TI.PYC ( baseMeasure ) )    -- 2026-10-31 changed: blank also when the current value is blank (CG YOY pattern); before, a period without data showed minus last year
	lineageTag: 9ab998f9-c51e-4c41-bdba-1ecc660e933a

