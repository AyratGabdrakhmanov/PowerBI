/// @param {EXPR} baseMeasure - the measure, e.g. [Sales Amount]
function 'TI.DOD' =
		( baseMeasure : EXPR ) =>
		TI.Change ( TI.DTD ( baseMeasure ), TI.PD ( baseMeasure ) )
	lineageTag: e1686fb2-989d-4186-baa8-43b2cf6b47fa

