function 'TI.PYMC' =
		( baseMeasure : EXPR ) =>
		CALCULATE (
		    baseMeasure
		    , DATEADD ( PARALLELPERIOD ( DATESMTD ( 'Calendar'[Date] ), 0, MONTH ), -1, YEAR )    -- whole last month in context; DATESMTD for the Total on Year level
